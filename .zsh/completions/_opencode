#compdef opencode

_opencode_global_opts() {
    _arguments -s \
        '(-h --help)'{-h,--help}'[show help]' \
        '(-v --version)'{-v,--version}'[show version number]' \
        '--print-logs[print logs to stderr]' \
        '--log-level[log level]:level:(DEBUG INFO WARN ERROR)' \
        '--pure[run without external plugins]' \
        '--port[port to listen on]:port' \
        '--hostname[hostname to listen on]:hostname' \
        '--mdns[enable mDNS service discovery]' \
        '--mdns-domain[custom domain name for mDNS]:domain' \
        '--cors[additional domains to allow for CORS]:domain' \
        '(-m --model)'{-m,--model}'[model to use]:model' \
        '(-c --continue)'{-c,--continue}'[continue the last session]' \
        '(-s --session)'{-s,--session}'[session id to continue]:session' \
        '--fork[fork session when continuing]' \
        '--prompt[prompt to use]:prompt' \
        '--agent[agent to use]:agent' \
        '--auto[auto-approve permissions (dangerous)]' \
        '--mini[start minimal interactive interface]' \
        '--no-replay[disable mini session history replay]' \
        '--replay-limit[cap visible mini replay]:limit'
}

_opencode_cmds() {
    local -a subcommands
    subcommands=(
        'acp:start ACP (Agent Client Protocol) server'
        'mcp:manage MCP (Model Context Protocol) servers'
        'attach:attach to a running opencode server'
        'run:run opencode with a message'
        'debug:debugging and troubleshooting tools'
        'providers:manage AI providers and credentials'
        'auth:manage AI providers and credentials'
        'agent:manage agents'
        'upgrade:upgrade opencode to latest or specific version'
        'uninstall:uninstall opencode and remove all related files'
        'serve:start a headless opencode server'
        'web:start opencode server and open web interface'
        'models:list all available models'
        'stats:show token usage and cost statistics'
        'export:export session data as JSON'
        'import:import session data from JSON file or URL'
        'github:manage GitHub agent'
        'pr:fetch and checkout a GitHub PR branch'
        'session:manage sessions'
        'plugin:install plugin and update config'
        'plug:install plugin and update config'
        'db:database tools'
        'completion:generate shell completion script'
    )
    _describe -t commands 'opencode' subcommands
}

_opencode() {
    local curcontext="$curcontext" state line
    typeset -A opt_args

    _arguments -C \
        '(-h --help)'{-h,--help}'[show help]' \
        '(-v --version)'{-v,--version}'[show version number]' \
        '--print-logs[print logs to stderr]' \
        '--log-level[log level]:level:(DEBUG INFO WARN ERROR)' \
        '--pure[run without external plugins]' \
        '--port[port to listen on]:port' \
        '--hostname[hostname to listen on]:hostname' \
        '--mdns[enable mDNS service discovery]' \
        '--mdns-domain[custom domain name for mDNS]:domain' \
        '--cors[additional domains to allow for CORS]:domain' \
        '(-m --model)'{-m,--model}'[model to use]:model' \
        '(-c --continue)'{-c,--continue}'[continue the last session]' \
        '(-s --session)'{-s,--session}'[session id to continue]:session' \
        '--fork[fork session when continuing]' \
        '--prompt[prompt to use]:prompt' \
        '--agent[agent to use]:agent' \
        '--auto[auto-approve permissions (dangerous)]' \
        '--mini[start minimal interactive interface]' \
        '--no-replay[disable mini session history replay]' \
        '--replay-limit[cap visible mini replay]:limit' \
        '1: :->cmds' \
        '*:: :->args'

    case $state in
        cmds)
            _opencode_cmds
            ;;
        args)
            case $words[1] in
                mcp)
                    _opencode_mcp
                    ;;
                providers|auth)
                    _opencode_providers
                    ;;
                agent)
                    _opencode_agent
                    ;;
                session)
                    _opencode_session
                    ;;
                github)
                    _opencode_github
                    ;;
                db)
                    _opencode_db
                    ;;
                debug)
                    _opencode_debug
                    ;;
                models)
                    _opencode_models
                    ;;
                export)
                    _opencode_export
                    ;;
                import)
                    _opencode_import
                    ;;
                upgrade)
                    _opencode_upgrade
                    ;;
                plugin|plug)
                    _opencode_plugin
                    ;;
                attach)
                    _arguments '1:url:'
                    ;;
                run)
                    _arguments '*:message:'
                    ;;
                pr)
                    _arguments '1:pr number:'
                    ;;
                serve|web|stats|uninstall|completion|acp)
                    _message "no additional arguments"
                    ;;
            esac
            ;;
    esac
}

_opencode_mcp() {
    local curcontext="$curcontext" state line
    typeset -A opt_args

    _arguments -C \
        '(-h --help)'{-h,--help}'[show help]' \
        '(-v --version)'{-v,--version}'[show version number]' \
        '--print-logs[print logs to stderr]' \
        '--log-level[log level]:level:(DEBUG INFO WARN ERROR)' \
        '--pure[run without external plugins]' \
        '1: :->cmds' \
        '*:: :->args'

    case $state in
        cmds)
            local -a sub
            sub=(
                'add:add an MCP server'
                'list:list MCP servers and their status'
                'ls:list MCP servers and their status'
                'auth:authenticate with an OAuth-enabled MCP server'
                'logout:remove OAuth credentials for an MCP server'
                'debug:debug OAuth connection for an MCP server'
            )
            _describe -t commands 'mcp' sub
            ;;
        args)
            case $words[1] in
                add)
                    _arguments \
                        '--url[URL for a remote MCP server]:url' \
                        '--env[environment variable (KEY=VALUE)]:env' \
                        '--header[HTTP header (KEY=VALUE)]:header'
                    ;;
                auth)
                    _opencode_mcp_auth
                    ;;
                logout|debug)
                    _arguments '1:mcp server name:'
                    ;;
                list|ls)
                    _message "no additional arguments"
                    ;;
            esac
            ;;
    esac
}

