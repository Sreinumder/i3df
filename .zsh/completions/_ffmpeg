                'rtsp:RTSP output'
                's22be:raw signed 22-bit big-endian'
                's22le:raw signed 22-bit little-endian'
                's24be:raw signed 24-bit big-endian'
                's24le:raw signed 24-bit little-endian'
                's32be:raw signed 32-bit big-endian'
                's32le:raw signed 32-bit little-endian'
                's8:raw signed 8-bit'
                'sbc:raw SBC'
                'scc:Scenarist Closed Captions'
                'sdl2:SDL2 output'
