#compdef ffmpeg

_ffmpeg() {
    local curcontext="$curcontext" state line
    typeset -A opt_args

    _arguments -C \
        '(- 1 *)'{-L,--license}'[show license]' \
        '(- 1 *)'{-version,--version}'[show version]' \
        '(- :)'{-h,--help}'[show help]:topic:->help_topics' \
        '(- 1 *)'{-?,-help,--help}'[show help]:topic:->help_topics' \
        '(- 1 *)--buildconf[show build configuration]' \
        '(- 1 *)-formats[show available formats]' \
        '(- 1 *)-codecs[show available codecs]' \
        '(- 1 *)-decoders[show available decoders]' \
        '(- 1 *)-encoders[show available encoders]' \
        '(- 1 *)-bsfs[show available bitstream filters]' \
        '(- 1 *)-protocols[show available protocols]' \
        '(- 1 *)-filters[show available filters]' \
        '(- 1 *)-pix_fmts[show available pixel formats]' \
        '(- 1 *)-layouts[show standard channel layouts]' \
        '(- 1 *)-sample_fmts[show available audio sample formats]' \
        '(- 1 *)-colors[show available color names]' \
        '(- 1 *)-dispositions[show available stream dispositions]' \
        '(- 1 *)-muxers[show available muxers]' \
        '(- 1 *)-demuxers[show available demuxers]' \
        '(- 1 *)-devices[show available devices]' \
        '(- 1 *)-hwaccels[show available HW acceleration methods]' \
        '(- 1 *)-sources[list sources of the input device]:device' \
        '(- 1 *)-sinks[list sinks of the output device]:device' \
        '(-y -n)-y[overwrite output files]' \
        '(-y -n)-n[never overwrite output files]' \
        '(-v --loglevel)'{-v,--loglevel}'[set logging level]:level:(quiet panic fatal error warning info verbose debug trace)' \
        '-report[generate a report]' \
        '--stats[print progress report during encoding]' \
        '--max_alloc[maximum size of a single allocated block]:bytes' \
        '--cpuflags[force specific cpu flags]:flags' \
        '--cpucount[force specific cpu count]:count' \
        '--hide_banner[do not show program banner]' \
        '--ignore_unknown[ignore unknown stream types]' \
        '--copy_unknown[copy unknown stream types]' \
        '--recast_media[allow recasting stream type]' \
        '--benchmark[add timings for benchmarking]' \
        '--benchmark_all[add timings for each task]' \
        '--progress[write program-readable progress info]:url' \
        '-stdin[enable or disable interaction on standard input]' \
        '--timelimit[set max runtime in CPU user time]:limit' \
        '-dump[dump each input packet]' \
        '-hex[when dumping packets also dump payload]' \
        '--debug_ts[print timestamp debugging info]' \
        '--filter_threads[number of non-complex filter threads]:number' \
        '--filter_complex[create a complex filtergraph]:graph' \
        '--filter_complex_threads[number of threads for filter_complex]:number' \
        '--lavfi[create a complex filtergraph]:graph' \
        '--filter_complex_script[load filtergraph from file]:file:_files' \
        '--auto_conversion_filters[enable automatic conversion filters]' \
        '--stats_period[set stats update period]:time' \
        '--max_error_rate[max error rate]:rate' \
        '--vstats[dump video coding statistics to file]' \
        '--vstats_file[dump video coding statistics to file]:file:_files' \
        '--sdp_file[specify sdp output file]:file:_files' \
        '--init_hw_device[initialise hardware device]:args' \
        '--filter_hw_device[set hardware device used when filtering]:device' \
        '--vsync[set video sync method]:method:(cfr vfr drop auto)' \
        '(-i)'{-i+,--input}'[input file]:file:_files' \
        '-f[force container format]:format:->formats' \
        '-t[stop transcoding after duration]:duration' \
        '-to[stop transcoding at time]:time' \
        '-ss[start transcoding at time]:time_off' \
        '-sseof[set start time offset relative to EOF]:time_off' \
        '-seek_timestamp[enable/disable seeking by timestamp with -ss]' \
        '-accurate_seek[enable/disable accurate seeking with -ss]' \
        '-isync[indicate input index for sync reference]:index' \
        '-itsoffset[set input ts offset]:time_off' \
        '--re[read input at native frame rate]' \
        '--readrate[read input at specified rate]:speed' \
        '--stream_loop[set number of times input stream shall be looped]:count' \
        '--find_stream_info[read stream info with heuristics]' \
        '-map[set input stream mapping]:mapping' \
        '-map_metadata[set metadata mapping]:mapping' \
        '-map_chapters[set chapters mapping]:index' \
        '-metadata[add metadata]:key=value' \
        '-program[add program with specified streams]:spec' \
        '-stream_group[add stream group]:spec' \
        '-dframes[set number of data frames to output]:number' \
        '-target[specify target file type]:type:(vcd svcd dvd dv dv50 pal-vcd pal-svcd pal-dvd pal-dv pal-dv50 ntsc-vcd ntsc-svcd ntsc-dvd ntsc-dv ntsc-dv50 film-vcd film-svcd film-dvd film-dv film-dv50)' \
        '-shortest[finish encoding within shortest input]' \
        '-qscale[use fixed quality scale]:q' \
        '-profile[set profile]:profile' \
        '-attach[add attachment to output file]:file:_files' \
        '-muxdelay[set max demux-decode delay]:seconds' \
        '-muxpreload[set initial demux-decode delay]:seconds' \
        '-fpre[set options from preset file]:file:_files' \
        '-c[select encoder/decoder]:codec:->codecs' \
        '-codec[select encoder/decoder]:codec:->codecs' \
        '-c:v[select video encoder/decoder]:codec:->vencoders' \
        '-c:V[select video encoder/decoder]:codec:->vencoders' \
        '-vcodec[select video encoder/decoder]:codec:->vencoders' \
        '-c:a[select audio encoder/decoder]:codec:->aencoders' \
        '-c:A[select audio encoder/decoder]:codec:->aencoders' \
        '-acodec[select audio encoder/decoder]:codec:->aencoders' \
        '-c:s[select subtitle encoder/decoder]:codec:->sencoders' \
        '-scodec[select subtitle encoder/decoder]:codec:->sencoders' \
        '-filter[apply filters to audio/video]:filter_graph' \
        '-vf[apply video filters]:filter_graph:->vfilters' \
        '-filter:v[apply video filters]:filter_graph:->vfilters' \
        '-af[apply audio filters]:filter_graph:->afilters' \
        '-filter:a[apply audio filters]:filter_graph:->afilters' \
        '-filter_script[load filter from file]:file:_files' \
        '-frames[set number of frames to output]:number' \
        '-tag[force codec tag]:fourcc' \
        '-time_base[set desired time base hint]:ratio' \
        '-enc_time_base[set desired encoder time base]:ratio' \
        '-bsf[set bitstream filters]:filters' \
        '-max_muxing_queue_size[max packets in muxing queue]:packets' \
        '-r[override input framerate / set output framerate]:rate' \
        '-aspect[set aspect ratio]:aspect' \
        '-vn[disable video]' \
        '-b[set bitrate]:bitrate' \
        '-b:v[set video bitrate]:bitrate' \
        '-b:a[set audio bitrate]:bitrate' \
        '-b:s[set subtitle bitrate]:bitrate' \
        '-vframes[set number of video frames to output]:number' \
        '-aframes[set number of audio frames to output]:number' \
        '-fpsmax[set max frame rate]:rate' \
        '-pix_fmt[set pixel format]:format:->pix_fmts' \
        '-pixel_format[set pixel format]:format:->pix_fmts' \
        '-an[disable audio]' \
        '-sn[disable subtitle]' \
        '-dn[disable data]' \
        '-ar[set audio sampling rate]:rate' \
        '-ac[set number of audio channels]:channels' \
        '-vol[set audio volume]:volume' \
        '-sample_fmt[set audio sample format]:format:->sample_fmts' \
        '-sample_format[set audio sample format]:format:->sample_fmts' \
        '-channel_layout[set audio channel layout]:layout:->layouts' \
        '-preset[set encoding preset]:preset' \
        '-tune[set encoding tuning]:tune' \
        '-crf[set constant rate factor]:crf' \
        '-qp[set quantizer parameter]:qp' \
        '-minrate[set min bitrate]:bitrate' \
        '-maxrate[set max bitrate]:bitrate' \
        '-bufsize[set ratecontrol buffer size]:size' \
        '-rc[set rate control method]:method:(vbr cbr cqp vbr_hq cbr_hq)' \
        '-g[set GOP size]:gop_size' \
        '-keyint_min[set minimum GOP size]:size' \
        '-refs[set reference frame count]:count' \
        '-bf[set B-frames count]:count' \
        '-sc_threshold[set scene change threshold]:threshold' \
        '-trellis[set trellis quantization]:trellis' \
        '-me_method[set motion estimation method]:method:(epzs esa tss tdls nt mcq full)' \
        '-movflags[mov/mp4 writing flags]:flags' \
        '-flags[set generic flags]:flags' \
        '-flags2[set second-gen generic flags]:flags' \
        '-strict[set strictness]:level' \
        '-threads[set thread count]:count' \
        '-profile:v[set video profile]:profile' \
        '-level[set encoding level]:level' \
        '-pass[select encoding pass]:pass:(1 2 3)' \
        '-passlogfile[pass log file name]:file:_files' \
        '-x264-params[set x264 options]:params' \
        '-x265-params[set x265 options]:params' \
        '-libx264opts[set libx264 options]:opts' \
        '-hwaccel[set hardware acceleration method]:method:(cuda dxva2 qsv vaapi videotoolbox d3d11va opencl vulkan)' \
        '-hwaccel_device[set hardware acceleration device]:device' \
        '-vaapi_device[set VAAPI hardware device]:device' \
        '-qsv_device[set QSV hardware device]:device' \
        *:output:_files

    case $state in
        help_topics)
            local -a topics
            topics=(
                'long:print more options'
                'full:print all options'
                'decoder:print decoder options'
                'encoder:print encoder options'
                'demuxer:print demuxer options'
                'muxer:print muxer options'
                'filter:print filter options'
                'bsf:print bitstream filter options'
                'protocol:print protocol options'
            )
            _describe -t topics 'help topic' topics
            ;;
        formats)
            local -a formats
            formats=(
                '3g2:3GP2'
                '3gp:3GP'
                'a64:a64 - video for Commodore 64'
                'aac:raw ADTS AAC'
                'ac3:raw AC-3'
                'ac4:raw AC-4'
                'adts:ADTS AAC'
                'adx:CRI ADX'
                'aiff:Audio IFF'
                'alaw:PCM A-law'
                'amr:3GPP AMR'
                'apng:Animated PNG'
